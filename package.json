{
	"name": "strata-gpuix-svelte",
	"private": true,
	"version": "0.0.0",
	"description": "Strata, a second brain in a native GPUI window: notes, links, images and voice memos, hybrid search and RAG chat, built with gpuix-svelte",
	"type": "module",
	"scripts": {
		"start": "gpuix-svelte --bun app.ts",
		"start:wayland": "DISPLAY= gpuix-svelte --bun app.ts",
		"start:x11": "WAYLAND_DISPLAY= gpuix-svelte --bun app.ts",
		"test": "gpuix-svelte --bun test/brain.ts && gpuix-svelte --bun test/smoke.ts",
		"build": "bun build.ts",
		"typecheck": "tsc --noEmit && svelte-check --diagnostic-sources js,svelte --fail-on-warnings",
		"ml:install": "bun install --cwd ml",
		"ml:doctor": "bun ml/doctor.ts",
		"import-hn": "bun scripts/import-hn.ts",
		"seed-load": "bun scripts/seed-load.ts",
		"frames": "gpuix-svelte --bun scripts/frame-cost.ts"
	},
	"engines": {
		"bun": ">=1.4.3"
	},
	"dependencies": {
		"croner": "^10.0.1",
		"gpuix-svelte": "^0.3.0",
		"marked": "^18.0.11",
		"mpg123-decoder": "^1.0.3",
		"wasm-media-encoders": "^0.7.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"@types/node": "^26.4.1",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3"
	}
}
