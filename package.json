{
	"name": "strata-gpuix-svelte",
	"private": true,
	"version": "1.1.2",
	"description": "Strata, a second brain in a native GPUI window: notes, links, images and voice memos, hybrid search and RAG chat, built with gpuix-svelte",
	"type": "module",
	"scripts": {
		"start": "bun node_modules/gpuix-svelte/bin/gpuix-svelte.js --bun app.ts",
		"start:wayland": "DISPLAY= bun node_modules/gpuix-svelte/bin/gpuix-svelte.js --bun app.ts",
		"start:x11": "WAYLAND_DISPLAY= bun node_modules/gpuix-svelte/bin/gpuix-svelte.js --bun app.ts",
		"test": "bun node_modules/gpuix-svelte/bin/gpuix-svelte.js --bun test/brain.ts && bun node_modules/gpuix-svelte/bin/gpuix-svelte.js --bun test/smoke.ts",
		"build": "bun build.ts",
		"typecheck": "tsc --noEmit && svelte-check --diagnostic-sources js,svelte --fail-on-warnings",
		"ml:install": "bun install --cwd ml",
		"ml:doctor": "bun ml/doctor.ts",
		"import-hn": "bun scripts/import-hn.ts",
		"seed-load": "bun scripts/seed-load.ts",
		"frames": "bun node_modules/gpuix-svelte/bin/gpuix-svelte.js --bun scripts/frame-cost.ts",
		"vendor-gpuix": "bun scripts/vendor-gpuix.ts"
	},
	"engines": {
		"bun": ">=1.4.3"
	},
	"dependencies": {
		"adm-zip": "^0.6.1",
		"croner": "^10.0.1",
		"gpuix-svelte": "^0.5.0",
		"marked": "^18.0.11",
		"mpg123-decoder": "^1.0.3",
		"wasm-media-encoders": "^0.7.0"
	},
	"devDependencies": {
		"@types/adm-zip": "^0.5.8",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.4.1",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3"
	}
}
